<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         verbose="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTodoAnnotatedTests="true">

    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
    </testsuites>

    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <!--
                Interface directories carry no executable behaviour — only the
                `if (!defined('ABSPATH')) exit;` boilerplate guard — so they
                have nothing to unit-test and only distort the coverage
                denominator. They are excluded here so the figure reflects the
                concrete classes that actually contain logic, the same reason
                Reach and Integrity exclude their src/Admin render glue.
            -->
            <directory>src/Contacts/Interfaces</directory>
            <directory>src/Core/Interfaces</directory>
            <directory>src/Groups/Interfaces</directory>
            <directory>src/IntergroupMeetings/Interfaces</directory>
            <directory>src/Locations/Interfaces</directory>
            <directory>src/Meetings/Interfaces</directory>
            <directory>src/Members/Interfaces</directory>
            <directory>src/Positions/Interfaces</directory>
            <directory>src/PrivacyPolicies/Interfaces</directory>
        </exclude>
        <report>
            <html outputDirectory="tests/coverage"/>
            <text outputFile="php://stdout"/>
        </report>
    </coverage>

    <php>
        <const name="UNITY_TESTING" value="true"/>
    </php>
</phpunit>
